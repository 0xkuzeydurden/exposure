# EXPOSURE configuration. Copy to .env.local (never committed) and restart `npm run dev`.
# Without a key the app still works: the waiting room replays the recorded scans for 0 credits.

# Nansen API key: get one at https://app.nansen.ai/api
NANSEN_API_KEY=

# ---------------------------------------------------------------- Nansen client (defaults shown)
# Requests per minute sent to Nansen; keep it under your plan's rate limit
NANSEN_RATE_PER_MIN=280
# Parallel in-flight requests
NANSEN_CONCURRENCY=6
# Hours to keep holder lists, who-bought-sold and pnl responses in .cache/nansen (default 24)
# NANSEN_CACHE_TTL_HOURS=24
# default | snapshot (never expire) | refresh (ignore cache, still write) | off
# NANSEN_CACHE=default
# off disables the local call ledger (.ledger/calls.ndjson) that `npm run ledger` summarises
# NANSEN_LEDGER=
# Folder that holds .cache/ and .ledger/ (default: the directory the app runs from; tests point it at a temp dir)
# EXPOSURE_ROOT=

# ---------------------------------------------------------------- live scans and credit budget
# Live scans spend credits. They run by default under `next dev` and in scripts; a production server
# (`next start`, a deployment) needs EXPOSURE_LIVE=1. EXPOSURE_LIVE=0 disables them everywhere.
# Quick scan: at most 13 credits on any chain. Deep scan: 18 + holders (+ buyers on EVM chains).
# EXPOSURE_LIVE=
# Credits live scans + wallet checks may spend per UTC day, and the part of it deep scans may use
# EXPOSURE_DAILY_CREDITS=80
# EXPOSURE_DEEP_DAILY_CREDITS=50
# If the account balance would fall below this after a scan (and every scan still running),
# live scans stop and the site is gallery-only
# EXPOSURE_CREDIT_FLOOR=400
# Per visitor per day (hashed IP; enforced in production, or anywhere with EXPOSURE_VISITOR_LIMITS=1)
# EXPOSURE_VISITOR_LIMITS=
# EXPOSURE_IP_TOKENS=1
# EXPOSURE_IP_SCANS=3
# EXPOSURE_IP_WALLETS=3
# Fan-out of a visitor-triggered deep scan (15 + 15 = 48 credits on EVM, 33 elsewhere)
# EXPOSURE_LIVE_MAX_BUYERS=15
# EXPOSURE_LIVE_MAX_HOLDERS=15
# A recorded live scan younger than this (minutes) is replayed instead of re-scanned
# EXPOSURE_SCAN_TTL_MIN=60

# ---------------------------------------------------------------- site
# Absolute site URL for Open Graph images (defaults to the Vercel URL or localhost)
# SITE_URL=
# Repository link printed on the end card of recording mode (?rec=1)
# NEXT_PUBLIC_REPO_URL=
